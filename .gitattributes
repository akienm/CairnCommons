
# The artifact journal meets another branch re-linked, never forked (ticket b7d2e05a1c93);
# the driver is installed per box: cairn artifact install-merge-driver <root>.
.artifact-journal.jsonl merge=cairn-journal

# The lab checks out LF on every box (ticket 3f2692580b2f). The compiler writes it LF, so a
# CRLF checkout under core.autocrlf=true read every recompile as dirt with an empty diff.
intentions-congruency-lab/** text eol=lf
